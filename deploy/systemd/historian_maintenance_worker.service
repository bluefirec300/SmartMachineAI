[Unit]
Description=SmartMachineAI Historian Retention & Backup Worker
After=network.target

[Service]
Type=simple
User=test
WorkingDirectory=/home/test/SmartMachineAI
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/test/SmartMachineAI/venv/bin/python -m app.historian_maintenance_worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
