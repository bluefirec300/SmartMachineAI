# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/

# Runtime data
logs/*
!logs/.gitkeep
backups/*
!backups/.gitkeep

# Databases and backups
database/*.db
database/*.db-*
database/*.sqlite
database/*.sqlite3
*.db
*.db-shm
*.db-wal

# Vendor manuals/datasheets - proprietary documents, not project source
manuals/*
!manuals/.gitkeep

# Local configuration and secrets
.env
.env.*
config/local_settings.json
config/secrets.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build / packaging
build/
dist/
*.egg-info/
